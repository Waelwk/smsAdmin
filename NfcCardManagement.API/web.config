<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    web.config pour déploiement IIS — ASP.NET Core 8 (In-Process)
    Modifiez uniquement connectionStrings pour changer la base de données sans recompiler.
  -->

  <!-- Chaîne de connexion SQL Server — lue via System.Configuration.ConfigurationManager -->
  <connectionStrings>
    <add name="CST_ConnectionString"
         connectionString="Data Source=192.168.1.126;User ID=sa;Password=@dmin123;Initial Catalog=CstDataSMS;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.webServer>

    <!-- Module ASP.NET Core — hébergement In-Process (recommandé IIS) -->
    <handlers>
      <add name="aspNetCore"
           path="*"
           verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\NfcCardManagement.API.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">

      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>

    </aspNetCore>

    <!-- En-têtes de sécurité HTTP -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- Désactiver les pages d'erreur IIS — laisser l'API retourner son propre JSON -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>

</configuration>
